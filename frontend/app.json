{
  "expo": {
    "name": "Cloudora LMS",
    "slug": "CloudoraLMS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["cloudora", "lms"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cloudora.lms",
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "Cloudora LMS requires camera access to capture assignment submissions, scan documents, and update profile photos.",
        "NSPhotoLibraryUsageDescription": "Cloudora LMS requires photo library access to upload educational resources, coursework files, and profile images.",
        "NSMicrophoneUsageDescription": "Cloudora LMS requires microphone access for recording educational audio and classroom voice notes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#070514"
      },
      "package": "com.cloudora.lms",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#070514",
      "barStyle": "light-content",
      "translucent": true
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070514",
      "dark": {
        "backgroundColor": "#070514",
        "image": "./assets/images/splash-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/cloudora-favicon.png",
      "title": "Cloudora LMS"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#070514",
          "dark": {
            "backgroundColor": "#070514",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Cloudora LMS to access your photos to upload coursework, profile images, and educational materials.",
          "cameraPermission": "Allow Cloudora LMS to access your camera to capture assignment submissions and profile photos."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/cloudora-favicon.png",
          "color": "#FF6900"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}